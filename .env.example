# Copia este archivo a .env y ajusta los valores. .env NO se versiona.
# Los puertos por defecto no chocan con bolsa-laboral (5433 / 3000 / 4200 / 4300).

# --- Base de datos (docker compose: servicio db) ---
POSTGRES_USER=comunidad
POSTGRES_PASSWORD=comunidad
POSTGRES_DB=comunidad
POSTGRES_PORT=5434

# --- Cliente Angular (docker compose: servicio client) ---
CLIENT_PORT=4201

# --- Landing pública (docker compose: servicio landing) ---
LANDING_PORT=4301

# --- Usuario con el que corren api y client en docker (por defecto 1000:1000; ver `id -u` / `id -g`) ---
# HOST_UID=1000
# HOST_GID=1000

# --- API keys de proveedores externos ---
# Agrega aquí una variable por proveedor, p. ej.:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- API NestJS (docker compose: servicio api) ---
API_PORT=3001
# Conexión desde el host. Dentro del compose se sobreescribe apuntando a db:5432.
DATABASE_URL=postgresql://comunidad:comunidad@localhost:5434/comunidad

# --- Identidad (services/api) ---
# Secreto con el que se firman los JWT. Cámbialo fuera de desarrollo.
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
