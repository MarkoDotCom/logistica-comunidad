%% Modelo de datos — gestión logística de comunidad (PostgreSQL)
%% Fuente de verdad: schema.sql. Renderizar: mmdc -i modelo.mmd -o modelo.svg
%% Esquemas: units (unit), users (app_user, unit_member), public (enums y set_updated_at)
erDiagram

  %% ---------------------------------------------------------------
  %% Relaciones
  %% ---------------------------------------------------------------
  unit o|--o{ unit : "parent_id"
  unit     ||--o{ unit_member : "tiene miembros"
  app_user ||--o{ unit_member : "tiene rol en"

  %% ---------------------------------------------------------------
  %% Entidades
  %% ---------------------------------------------------------------
  unit {
    uuid id PK
    uuid parent_id FK "NULL solo si kind = community"
    unit_kind kind "community | building | apartment | account"
    text code "único entre hermanos"
    text name
    boolean is_active
    timestamptz created_at
    timestamptz updated_at
  }

  app_user {
    uuid id PK
    citext email UK
    text external_auth_id UK
    text full_name
    text phone
    boolean is_active
    timestamptz created_at
    timestamptz updated_at
  }

  unit_member {
    uuid unit_id PK_FK
    uuid user_id PK_FK
    unit_role role PK "admin | owner | tenant | staff"
    timestamptz created_at
  }
