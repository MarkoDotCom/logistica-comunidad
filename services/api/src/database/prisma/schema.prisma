generator client {
  provider        = "prisma-client"
  output          = "../generated"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "public", "units", "users"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model unit {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parent_id  String?    @db.Uuid
  kind       unit_kind
  code       String     @unique(map: "unit_root_code_uq", where: raw("((parent_id IS NULL) AND (deleted_at IS NULL))"))
  name       String?
  deleted_at DateTime?  @db.Timestamptz(6)
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  updated_at DateTime   @default(now()) @db.Timestamptz(6)
  parent     unit?      @relation("unit_parent", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  children   unit[]     @relation("unit_parent")
  contracts  contract[]

  @@unique([parent_id, code], map: "unit_sibling_code_uq", where: raw("((parent_id IS NOT NULL) AND (deleted_at IS NULL))"))
  @@index([kind], map: "unit_kind_alive_idx", where: raw("(deleted_at IS NULL)"))
  @@index([parent_id], map: "unit_parent_alive_idx", where: raw("(deleted_at IS NULL)"))
  @@schema("units")
}

model app_user {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String          @unique @db.Citext
  external_auth_id String?         @unique
  full_name        String
  phone            String?
  is_active        Boolean         @default(true)
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @default(now()) @db.Timestamptz(6)
  credential       credential?
  refresh_tokens   refresh_token[]
  roles            user_role[]
  contracts        contract[]

  @@schema("users")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model contract {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unit_id      String        @db.Uuid
  user_id      String        @db.Uuid
  type         contract_type
  starts_at    DateTime      @default(dbgenerated("CURRENT_DATE")) @db.Date
  ends_at      DateTime?     @db.Date
  document_url String?
  notes        String?
  created_at   DateTime      @default(now()) @db.Timestamptz(6)
  updated_at   DateTime      @default(now()) @db.Timestamptz(6)
  unit         unit          @relation(fields: [unit_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         app_user      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([unit_id], map: "contract_unit_idx")
  @@index([user_id], map: "contract_user_idx")
  @@schema("users")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model permission {
  key         String            @id
  resource    String
  action      String
  description String
  roles       role_permission[]

  @@schema("auth")
}

model role {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String            @unique(map: "role_name_uq", where: raw("(deleted_at IS NULL)")) @db.Citext
  description String?
  is_system   Boolean           @default(false)
  deleted_at  DateTime?         @db.Timestamptz(6)
  created_at  DateTime          @default(now()) @db.Timestamptz(6)
  updated_at  DateTime          @default(now()) @db.Timestamptz(6)
  permissions role_permission[]
  users       user_role[]

  @@schema("auth")
}

model role_permission {
  role_id        String     @db.Uuid
  permission_key String
  permission     permission @relation(fields: [permission_key], references: [key], onDelete: Cascade, onUpdate: NoAction)
  role           role       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, permission_key])
  @@schema("auth")
}

model user_role {
  user_id    String   @db.Uuid
  role_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  role       role     @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       app_user @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, role_id])
  @@index([role_id], map: "user_role_role_idx")
  @@schema("auth")
}

model credential {
  user_id       String   @id @db.Uuid
  password_hash String
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
  user          app_user @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("auth")
}

model refresh_token {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique
  expires_at DateTime  @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  user       app_user  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "refresh_token_user_idx", where: raw("(revoked_at IS NULL)"))
  @@schema("auth")
}

enum unit_kind {
  community
  building
  apartment
  account

  @@schema("public")
}

enum contract_type {
  ownership
  lease
  administration
  employment

  @@schema("public")
}
