generator client {
  provider        = "prisma-client"
  output          = "../generated"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "units", "users"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model unit {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parent_id   String?       @db.Uuid
  kind        unit_kind
  code        String        @unique(map: "unit_root_code_uq", where: raw("(parent_id IS NULL)"))
  name        String?
  is_active   Boolean       @default(true)
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  updated_at  DateTime      @default(now()) @db.Timestamptz(6)
  parent      unit?         @relation("unit_parent", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  children    unit[]        @relation("unit_parent")
  members     unit_member[]

  @@unique([parent_id, code], map: "unit_sibling_code_uq", where: raw("(parent_id IS NOT NULL)"))
  @@index([kind])
  @@schema("units")
}

model app_user {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String        @unique @db.Citext
  external_auth_id String?       @unique
  full_name        String
  phone            String?
  is_active        Boolean       @default(true)
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime      @default(now()) @db.Timestamptz(6)
  memberships      unit_member[]

  @@schema("users")
}

model unit_member {
  unit_id    String    @db.Uuid
  user_id    String    @db.Uuid
  role       unit_role
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  unit       unit      @relation(fields: [unit_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       app_user  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([unit_id, user_id, role])
  @@index([user_id], map: "unit_member_user_idx")
  @@schema("users")
}

enum unit_kind {
  community
  building
  apartment
  account

  @@schema("public")
}

enum unit_role {
  admin
  owner
  tenant
  staff

  @@schema("public")
}
